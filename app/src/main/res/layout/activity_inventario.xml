<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F4EE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen principal -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/inventario"/>

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📦 Inventario"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#0D3B2A"
            android:layout_margin="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Centro de Simulación de Enfermería"
            android:textSize="16sp"
            android:layout_marginStart="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Última actualización: 03/06/2026"
            android:textSize="14sp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="10dp"/>

        <!-- Buscador -->
        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_margin="16dp"
            android:hint="🔍 Buscar insumo o equipo"/>

        <!-- Estadísticas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="🧤"
                        android:textSize="30sp"/>

                    <TextView
                        android:text="500"/>

                    <TextView
                        android:text="Guantes"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="💉"
                        android:textSize="30sp"/>

                    <TextView
                        android:text="250"/>

                    <TextView
                        android:text="Jeringas"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Guantes -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="🧤 Guantes por talla"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:text="Talla S: 150"/>

                <TextView
                    android:text="Talla M: 200"/>

                <TextView
                    android:text="Talla L: 150"/>

                <TextView
                    android:text="🟢 Disponible"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Jeringas -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="💉 Jeringas por medida"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:text="1 ml: 100"/>

                <TextView
                    android:text="3 ml: 80"/>

                <TextView
                    android:text="5 ml: 50"/>

                <TextView
                    android:text="10 ml: 20"/>

                <TextView
                    android:text="🟡 Stock Medio"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Carro de paro -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="🚑 Carro de Paro"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:text="✔ Desfibrilador"/>

                <TextView
                    android:text="✔ Ambú Adulto"/>

                <TextView
                    android:text="✔ Ambú Pediátrico"/>

                <TextView
                    android:text="✔ Monitor de Signos Vitales"/>

                <TextView
                    android:text="🟢 Operativo"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Alertas -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="⚠️ Productos próximos a agotarse"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

                <TextView
                    android:text="Catéter #18 - Cantidad: 3"/>

                <TextView
                    android:text="Jeringa 10 ml - Cantidad: 5"/>

                <TextView
                    android:text="Guantes talla L - Cantidad: 10"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Información final -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:layout_marginBottom="25dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="🏥 Información General"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:text="Equipos registrados: 45"/>

                <TextView
                    android:text="Insumos registrados: 1250"/>

                <TextView
                    android:text="Última auditoría: 02/06/2026"/>

                <TextView
                    android:text="Estado general: 🟢 Operativo"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>