<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Reserva"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center"/>

        <!-- Primera fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/etInstructor"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="Nombre del instructor"
                android:background="@android:drawable/editbox_background"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etPrograma"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="Programa"
                android:background="@android:drawable/editbox_background"/>

        </LinearLayout>

        <!-- Segunda fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etFicha"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="Ficha"
                android:inputType="number"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etFecha"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="Fecha"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etHora"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="Hora"/>

        </LinearLayout>

        <!-- Tercera fila -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/etSala"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="Sala"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etSimulacion"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="Simulación"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:text="Registrar"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="250dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:hint="Buscar reserva..."/>

        <!-- Tabla -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TableLayout
                android:id="@+id/tableReservas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TableRow
                    android:background="#0D8F36">

                    <TextView
                        android:text="Instructor"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="12dp"/>

                    <TextView
                        android:text="Programa"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="12dp"/>

                    <TextView
                        android:text="Ficha"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="12dp"/>

                    <TextView
                        android:text="Fecha"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="12dp"/>

                    <TextView
                        android:text="Hora"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="12dp"/>

                    <TextView
                        android:text="Sala"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="12dp"/>

                    <TextView
                        android:text="Estado"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:padding="12dp"/>

                </TableRow>

            </TableLayout>

        </HorizontalScrollView>

    </LinearLayout>

</ScrollView>